# 复制为 signing/keystore.properties 后填写自己的签名信息。
# 该文件与 .jks 都不应提交到版本库（见 .gitignore）。
#
# 制作 JKS：
#   keytool -genkeypair -v -keystore signing/my-release.jks \
#           -alias mykey -keyalg RSA -keysize 2048 -validity 10000
#
# 已有的 AOSP 风格密钥对（*.pk8 + *.x509.pem）需要先转成 JKS/PKCS12：
#   openssl pkcs8 -inform DER -in key.pk8 -nocrypt -out key.pem
#   openssl pkcs12 -export -nomac -inkey key.pem -in cert.x509.pem -out key.p12 -name alias
#   keytool -importkeystore -srckeystore key.p12 -srcstoretype PKCS12 \
#           -destkeystore signing/my-release.jks -deststoretype JKS

storeFile=signing/my-release.jks
storePassword=你的密钥库密码
keyAlias=你的别名
keyPassword=你的别名密码
